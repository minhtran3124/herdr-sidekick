# Copy to the plugin config dir (`herdr plugin config-dir minhtran3124.sidekick`)/config.env.
# Every setting is optional; the defaults are shown.

# Worktree board: open it when the repo has at least this many checkouts; panel width.
# WORKTREES_MIN=2
# WORKTREES_WIDTH=38

# Middle column (changes over agents): width.
# CHANGES_WIDTH=44
# AGENTS_WIDTH=44

# File-type icons need a Nerd Font; set to "plain" to turn them off.
# CHANGES_ICONS=plain

# GitHub CLI used for PR status. Default: the first `gh` on PATH that is not a pyenv shim.
# SIDEKICK_GH=/opt/homebrew/bin/gh

# Claude Code config dir, if not ~/.claude.
# CLAUDE_CONFIG_DIR=$HOME/.claude
